<?xml version="1.0" encoding="utf-8"?>
<!--
    dataExtractionRules for Android 12+ (API 31+).
    Excludes the CapacitorStorage shared-preferences file, which contains the
    auth token, from both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
