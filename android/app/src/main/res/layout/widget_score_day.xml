<?xml version="1.0" encoding="utf-8"?>
<!--
    Score Day · V4 Bento Bold
    4x2 home-screen widget.

    Structure:
      ┌───────────────────┬──────────┬──────────┐
      │                   │  STREAK  │   TIER   │
      │   SCORE  (hero)   ├──────────┴──────────┤
      │                   │       TASKS         │
      └───────────────────┴─────────────────────┘

    Notes:
      - Uses only RemoteViews-safe widget classes (LinearLayout / TextView / ImageView).
      - Java provider drives all text + tints; XML defines layout, drawables, and base styling.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <!-- ─── LEFT: Score hero tile ───────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:layout_marginEnd="6dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/tile_score_bg">

        <!-- header row: SCORE · TODAY + live dot + refresh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SCORE · TODAY"
                android:textColor="#7a7a86"
                android:textSize="9sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/widget_live_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#c6f24e"
                android:textSize="8sp"
                android:paddingEnd="6dp" />

            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↻"
                android:textColor="#5a5a66"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- spacer pushes hero to bottom -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="" />

        <!-- big score number -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/widget_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="93"
                android:textColor="#c6f24e"
                android:textSize="44sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="-0.04" />

            <TextView
                android:id="@+id/widget_score_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%"
                android:textColor="#5a5a66"
                android:textSize="22sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- pts subline -->
        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="63 / 68 pts"
            android:textColor="#7a7a86"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false" />

        <!-- progress bar (track + fill via two views with weights) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:background="@drawable/progress_track">

            <TextView
                android:id="@+id/widget_progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:text=""
                android:background="@drawable/progress_fill" />

            <TextView
                android:id="@+id/widget_progress_rest"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="100"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- ─── RIGHT COLUMN ────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical">

        <!-- Top row: Streak + Tier -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.7"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <!-- Streak tile -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@drawable/tile_sub_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STREAK"
                    android:textColor="#6a6a76"
                    android:textSize="8sp"
                    android:letterSpacing="0.12"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/widget_streak_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        android:textColor="#fbbf24"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="days"
                        android:textColor="#5a5a66"
                        android:textSize="9sp"
                        android:paddingStart="3dp"
                        android:paddingBottom="3dp"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tier tile -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@drawable/tile_sub_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIER"
                    android:textColor="#6a6a76"
                    android:textSize="8sp"
                    android:letterSpacing="0.12"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/widget_tier_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S"
                        android:textColor="#a5b4fc"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:id="@+id/widget_tier_delta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↑2"
                        android:textColor="#5a5a66"
                        android:textSize="9sp"
                        android:paddingStart="4dp"
                        android:paddingBottom="3dp"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Tasks tile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/tile_sub_bg"
            android:gravity="center_vertical">

            <!-- Task rows -->
            <LinearLayout
                android:id="@+id/widget_task_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- row 0 -->
                <LinearLayout
                    android:id="@+id/task_row_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/task_check_0"
                        android:layout_width="14dp"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textSize="11sp"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/task_title_0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingStart="6dp"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/task_weight_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:paddingStart="6dp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- row 1 -->
                <LinearLayout
                    android:id="@+id/task_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/task_check_1"
                        android:layout_width="14dp"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textSize="11sp"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/task_title_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingStart="6dp"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/task_weight_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:paddingStart="6dp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- row 2 -->
                <LinearLayout
                    android:id="@+id/task_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/task_check_2"
                        android:layout_width="14dp"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textSize="11sp"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/task_title_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingStart="6dp"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/task_weight_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:paddingStart="6dp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- row 3 -->
                <LinearLayout
                    android:id="@+id/task_row_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/task_check_3"
                        android:layout_width="14dp"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textSize="11sp"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/task_title_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingStart="6dp"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/task_weight_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:paddingStart="6dp"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Empty-state label (planning / rest) -->
            <TextView
                android:id="@+id/widget_empty_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#7a7a86"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
