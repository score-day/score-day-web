<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- ── Header row: app name + streak ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SCORE DAY"
            android:textColor="#3d3d5c"
            android:textSize="8sp"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#c4b5fd"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ── Content row: score panel + divider + task list ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left panel: score % and pts -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#a78bfa"
                android:textSize="32sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#555577"
                android:textSize="9sp"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false" />

        </LinearLayout>

        <!-- Vertical divider — View base class is blocked in Android 15 RemoteViews, use TextView -->
        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="#2d2a4a" />

        <!-- Right panel: top-4 task rows (active/locked) -->
        <LinearLayout
            android:id="@+id/widget_task_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:visibility="gone">

            <LinearLayout android:id="@+id/task_row_0" android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:visibility="gone">
                <TextView android:id="@+id/task_check_0" android:layout_width="14dp" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:id="@+id/task_title_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:paddingStart="5dp" android:includeFontPadding="false" />
                <TextView android:id="@+id/task_weight_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:paddingStart="6dp" android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout android:id="@+id/task_row_1" android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:visibility="gone">
                <TextView android:id="@+id/task_check_1" android:layout_width="14dp" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:id="@+id/task_title_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:paddingStart="5dp" android:includeFontPadding="false" />
                <TextView android:id="@+id/task_weight_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:paddingStart="6dp" android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout android:id="@+id/task_row_2" android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:visibility="gone">
                <TextView android:id="@+id/task_check_2" android:layout_width="14dp" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:id="@+id/task_title_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:paddingStart="5dp" android:includeFontPadding="false" />
                <TextView android:id="@+id/task_weight_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:paddingStart="6dp" android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout android:id="@+id/task_row_3" android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:visibility="gone">
                <TextView android:id="@+id/task_check_3" android:layout_width="14dp" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:id="@+id/task_title_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:paddingStart="5dp" android:includeFontPadding="false" />
                <TextView android:id="@+id/task_weight_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:paddingStart="6dp" android:includeFontPadding="false" />
            </LinearLayout>

        </LinearLayout>

        <!-- Empty-state label (planning / rest / unknown) -->
        <TextView
            android:id="@+id/widget_empty_label"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#555577"
            android:textSize="10sp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
